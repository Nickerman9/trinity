        tx_id: [u8; 32],
        reason: AbortReason,
    },
}

struct ShardManager {
    shards: RwLock<BTreeMap<ShardId, ShardState>>,
    pending_transactions: Mutex<HashMap<[u8; 32], CrossShardTx>>,
    merkle_tree: Arc<MerkleTree>,
    recovery_queue: Mutex<VecDeque<RecoveryTask>>,
    topology: RwLock<ShardTopology>,
    cross_shard_coordinator: CrossShardCoordinator,
    epoch: AtomicU64,
}

#[derive(Debug, Clone)]
struct ShardState {
    validators: Vec<PeerId>,
    state_root: [u8; 32],
    pending_writes: BTreeMap<Vec<u8>, Vec<u8>>,
    last_committed: u64,
    merkle_prover: MerkleProver,
}

struct CrossShardCoordinator {
    active_transactions: Mutex<HashMap<[u8; 32], TransactionState>>,
    shard_clients: RwLock<BTreeMap<ShardId, ShardClient>>,
    config: CoordinatorConfig,
    recovery_handler: RecoveryHandler,
}

#[derive(Debug, Clone)]
struct TransactionState {
    phase: TransactionPhase,
    prepared_shards: HashSet<ShardId>,
    required_shards: HashSet<ShardId>,
    proofs: BTreeMap<ShardId, MerkleProof>,
    timeout: Instant,
}

#[derive(Debug, Clone, Copy, PartialEq)]
enum TransactionPhase {
    Preparing,
    Committing,
    Aborting,
}

impl ShardManager {
    pub fn new(initial_shards: BTreeMap<ShardId, Vec<PeerId>>) -> Self {
        let merkle_tree = Arc::new(MerkleTree::new());
        let coordinator = CrossShardCoordinator::new(merkle_tree.clone());
        
        Self {
            shards: RwLock::new(initial_shards.into_iter().map(|(id, validators)| {
                (id, ShardState {
                    validators,
                    state_root: [0; 32],
                    pending_writes: BTreeMap::new(),
                    last_committed: 0,
                    merkle_prover: MerkleProver::new(),
                })
            }).collect()),
            pending_transactions: Mutex::new(HashMap::new()),
            merkle_tree,
            recovery_queue: Mutex::new(VecDeque::new()),
            topology: RwLock::new(ShardTopology::default()),
            cross_shard_coordinator: coordinator,
            epoch: AtomicU64::new(0),
        }
    }

    #[instrument(skip(self, tx))]
    pub async fn submit_transaction(&self, tx: Transaction) -> Result<[u8; 32], ShardError> {
        let tx_id = self.hash_transaction(&tx);
        let involved_shards = self.determine_involved_shards(&tx)?;
        
        let cross_tx = CrossShardTx {
            tx,
            initiator: self.local_shard_id(),
            involved_shards: involved_shards.clone(),
            state: TransactionState {
                phase: TransactionPhase::Preparing,
                prepared_shards: HashSet::new(),
                required_shards: involved_shards,
                proofs: BTreeMap::new(),
                timeout: Instant::now() + SHARD_COMMIT_TIMEOUT,
            },
        };

        self.pending_transactions.lock().insert(tx_id, cross_tx);
        self.begin_commit_process(tx_id).await?;
        Ok(tx_id)
    }

    #[instrument(skip(self))]
    async fn begin_commit_process(&self, tx_id: [u8; 32]) -> Result<(), ShardError> {
        let tx = self.pending_transactions.lock().get(&tx_id)
            .ok_or(ShardError::TxNotFound)?.clone();

        // Phase 1: Prepare
        let prepare_msg = ShardMessage::Prepare {
            tx_id,
            operations: self.split_operations(&tx.tx),
            initiator: self.local_shard_id(),
        };

        for shard_id in &tx.state.required_shards {
            self.send_to_shard(*shard_id, prepare_msg.clone()).await?;
        }

        self.cross_shard_coordinator.track_transaction(tx_id, tx.state);
        Ok(())
    }

    #[instrument(skip(self, msg))]
    pub async fn handle_message(&self, msg: ShardMessage) -> Result<(), ShardError> {
        match msg {
            ShardMessage::Prepare { tx_id, operations, initiator } => {
                self.handle_prepare(tx_id, operations, initiator).await
            }
            ShardMessage::Prepared { tx_id, shard_id, proof, signature } => {
                self.handle_prepared(tx_id, shard_id, proof, signature).await
            }
            ShardMessage::Commit { tx_id, final_proofs } => {
                self.handle_commit(tx_id, final_proofs).await
            }
            ShardMessage::Abort { tx_id, reason } => {
                self.handle_abort(tx_id, reason).await
            }
        }
    }

    #[instrument(skip(self))]
    async fn handle_prepare(
        &self,
        tx_id: [u8; 32],
        operations: BTreeMap<ShardId, Vec<ShardOp>>,
        initiator: ShardId,
    ) -> Result<(), ShardError> {
        let ops = operations.get(&self.local_shard_id())
            .ok_or(ShardError::InvalidShardAssignment)?;

        // Tentative execution
        let mut state_copy = self.shard_state().clone();
        for op in ops {
            state_copy.apply_operation(op)?;
        }

        // Generate Merkle proof
        let proof = self.merkle_prover.generate_proof(&state_copy.state_root)?;
        let signature = self.sign_proof(&proof)?;

        let msg = ShardMessage::Prepared {
            tx_id,
            shard_id: self.local_shard_id(),
            proof,
            signature,
        };

        self.send_to_shard(initiator, msg).await
    }

    #[instrument(skip(self))]
    async fn handle_prepared(
        &self,
        tx_id: [u8; 32],
        shard_id: ShardId,
        proof: MerkleProof,
        signature: Signature,
    ) -> Result<(), ShardError> {
        // Verify signature and proof
        self.verify_shard_signature(shard_id, &proof, &signature)?;
        self.merkle_tree.verify_proof(&proof)?;

        let mut tx_state = self.cross_shard_coordinator.get_transaction_state(tx_id)?;
        tx_state.prepared_shards.insert(shard_id);
        tx_state.proofs.insert(shard_id, proof);

        // Check if all shards prepared
        if tx_state.prepared_shards == tx_state.required_shards {
            self.finalize_commit(tx_id).await?;
        }

        Ok(())
    }

    #[instrument(skip(self))]
    async fn finalize_commit(&self, tx_id: [u8; 32]) -> Result<(), ShardError> {
        let mut tx = self.pending_transactions.lock().get_mut(&tx_id)
            .ok_or(ShardError::TxNotFound)?;
        
        // Phase 2: Commit
        let commit_msg = ShardMessage::Commit {
            tx_id,
            final_proofs: tx.state.proofs.clone(),
        };

        for shard_id in &tx.state.required_shards {
            self.send_to_shard(*shard_id, commit_msg.clone()).await?;
        }

        // Apply local changes
        self.apply_transaction(&tx.tx)?;
        self.pending_transactions.lock().remove(&tx_id);
        Ok(())
    }

    #[instrument(skip(self))]
    fn apply_transaction(&self, tx: &Transaction) -> Result<(), ShardError> {
        let mut shard = self.shard_state();
        for op in &tx.operations {
            shard.apply_operation(op)?;
        }
        shard.last_committed = self.epoch.load(Ordering::Relaxed);
        Ok(())
    }
}

// Complete Merkle Proof System
struct MerkleTree {
    nodes: RwLock<HashMap<[u8; 32], [u8; 32]>>,
    root: AtomicCell<[u8; 32]>,
}

impl MerkleTree {
    const EMPTY_HASH: [u8; 32] = [0u8; 32];

    fn new() -> Self {
        Self {
            nodes: RwLock::new(HashMap::new()),
            root: AtomicCell::new(Self::EMPTY_HASH),
        }
    }

    fn update_batch(&self, updates: &[(&[u8], &[u8])]) -> Result<[u8; 32], ShardError> {
        let mut nodes = self.nodes.write();
        let mut queue = VecDeque::new();

        // Insert/update leaves
        for (key, value) in updates {
            let hash = Self::hash_pair(key, value);
            nodes.insert(Self::hash_key(key), hash);
            queue.push_back(Self::hash_key(key));
        }

        // Recompute hashes up to root
        while let Some(node) = queue.pop_front() {
            let parent = Self::parent_node(node);
            let left = nodes.get(&Self::left_child(parent)).copied().unwrap_or(Self::EMPTY_HASH);
            let right = nodes.get(&Self::right_child(parent)).copied().unwrap_or(Self::EMPTY_HASH);
            let new_hash = Self::hash_pair(&left, &right);
            
            if nodes.insert(parent, new_hash).is_none() {
                queue.push_back(parent);
            }
        }

        let new_root = nodes.get(&Self::root_node()).copied().unwrap_or(Self::EMPTY_HASH);
        self.root.store(new_root);
        Ok(new_root)
    }

    fn generate_proof(&self, key: &[u8]) -> Result<MerkleProof, ShardError> {
        let nodes = self.nodes.read();
        let mut path = Vec::with_capacity(MERKLE_PROOF_DEPTH);
        let mut current = Self::hash_key(key);

        for _ in 0..MERKLE_PROOF_DEPTH {
            let parent = Self::parent_node(current);
            let sibling = if Self::is_left_child(current) {
                Self::right_child(parent)
            } else {
                Self::left_child(parent)
            };
            
            path.push(nodes.get(&sibling).copied().unwrap_or(Self::EMPTY_HASH));
            current = parent;
        }

        Ok(MerkleProof {
            leaf_hash: nodes.get(&Self::hash_key(key)).copied().unwrap_or(Self::EMPTY_HASH),
            path,
        })
    }

    fn verify_proof(&self, proof: &MerkleProof) -> Result<bool, ShardError> {
        let mut current = proof.leaf_hash;
        for (i, sibling) in proof.path.iter().enumerate() {
            let parent = if i % 2 == 0 {
                Self::hash_pair(&current, sibling)
            } else {
                Self::hash_pair(sibling, &current)
            };
            current = parent;
        }
        Ok(current == self.root.load())
    }
}

