//! verification.rs - Z3 + TLA+ Hybrid Prover
#![forbid(unsafe_code)]
#![deny(clippy::all)]

use std::{
    collections::BTreeMap,
    process::{Command, Stdio},
    sync::Arc,
    time::{Duration, Instant},
};
use rayon::prelude::*;
use serde::{Deserialize, Serialize};
use z3::{
    ast::{Ast, Bool, Int, BitVec},
    Config, Context, SatResult, Solver, Sort,
};
use tlc::tla::TlaValue;
use tempfile::NamedTempFile;
use thiserror::Error;
use tracing::{debug, instrument};

const Z3_TIMEOUT: u64 = 5000; // 5 seconds
const TLC_TIMEOUT: Duration = Duration::from_secs(30);

#[derive(Clone)]
struct ProtocolVerifier {
    z3_ctx: Arc<Context>,
    tla_bank: TlaModelBank,
    economic_model: EconomicConstraints,
    safety_properties: Vec<SafetyPredicate>,
}

#[derive(Debug, Clone, Serialize)]
struct BlockModel {
    parent_hash: BitVec,
    timestamp: Int,
    state_root: BitVec,
    proposer: Int,
    votes: BTreeMap<Int, Bool>,
    view: Int,
}

impl ProtocolVerifier {
    pub fn new(models_dir: &str) -> Result<Self, VerificationError> {
        let mut cfg = Config::new();
        cfg.set_timeout(Z3_TIMEOUT);
        let ctx = Context::new(&cfg);
        
        Ok(Self {
            z3_ctx: Arc::new(ctx),
            tla_bank: TlaModelBank::load(models_dir)?,
            economic_model: EconomicConstraints::default(),
            safety_properties: vec![
                SafetyPredicate::new("hash_chain", 2, |blocks| {
                    blocks[1].parent_hash._eq(&blocks[0].state_root)
                }),
                SafetyPredicate::new("time_monotonic", 2, |blocks| {
                    blocks[1].timestamp.gt(&blocks[0].timestamp)
                }),
                SafetyPredicate::new("quorum_intersection", 3, |blocks| {
                    let q1 = blocks[1].votes.values().fold(ctx.false(), |acc, v| acc | v);
                    let q2 = blocks[2].votes.values().fold(ctx.false(), |acc, v| acc | v);
                    q1 & q2
                }),
            ],
        })
    }

    #[instrument(skip(self, block))]
    pub fn verify_block(&self, block: &Block) -> Result<(), VerificationError> {
        // 1. Z3 SMT Proof
        let z3_model = self.build_z3_model(block)?;
        let solver = Solver::new(&self.z3_ctx);
        
        // Add protocol invariants
        solver.assert(&self.economic_model.slash_condition(&z3_model));
        for prop in &self.safety_properties {
            solver.assert(&prop.apply(&[z3_model.clone()]));
        }

        // 2. TLA+ Model Check
        let tla_instance = self.tla_bank.create_instance("consensus.tla")?;
        tla_instance.add_constant("Block", block.to_tla())?;
        let trace = tla_instance.check()?;

        // 3. Runtime Assertions
        self.check_runtime_invariants(block)?;

        match solver.check() {
            SatResult::Unsat => Ok(()),
            SatResult::Sat => Err(VerificationError::Counterexample(
                solver.get_model().unwrap().to_string()
            )),
            SatResult::Unknown => Err(VerificationError::Z3Unknown),
        }
    }

    fn build_z3_model(&self, block: &Block) -> Result<BlockModel, VerificationError> {
        let ctx = &self.z3_ctx;
        Ok(BlockModel {
            parent_hash: BitVec::from_bytes(ctx, &block.parent_hash),
            timestamp: Int::from_u64(ctx, block.timestamp),
            state_root: BitVec::from_bytes(ctx, &block.state_root),
            proposer: Int::from_u64(ctx, block.proposer.into()),
            votes: block.votes.iter().map(|(v, s)| {
                (Int::from_u64(ctx, v.into()), Bool::from_bool(ctx, *s))
            }).collect(),
            view: Int::from_u64(ctx, block.view),
        })
    }

    #[instrument(skip(self))]
    fn check_runtime_invariants(&self, block: &Block) -> Result<(), VerificationError> {
        // Cross-check with compiled invariants
        invariant!(block.timestamp > self.last_block.timestamp, 
            VerificationError::TimeViolation);
        invariant!(block.view == self.last_block.view + 1,
            VerificationError::ViewViolation);
        
        let quorum = block.votes.values().filter(|&v| *v).count();
        invariant!(quorum >= self.quorum_size(),
            VerificationError::QuorumViolation);

        Ok(())
    }
}

struct TlaModelBank {
    models: BTreeMap<String, TlaModel>,
    tlc_path: PathBuf,
    java_path: PathBuf,
}

impl TlaModelBank {
    fn load(dir: &str) -> Result<Self, VerificationError> {
        let mut models = BTreeMap::new();
        for entry in std::fs::read_dir(dir)? {
            let path = entry?.path();
            if path.extension().map_or(false, |e| e == "tla") {
                let content = std::fs::read_to_string(&path)?;
                models.insert(path.file_stem().unwrap().to_str().unwrap().into(), 
                    TlaModel::parse(content)?);
            }
        }
        Ok(Self {
            models,
            tlc_path: locate_binary("tlc")?,
            java_path: locate_binary("java")?,
        })
    }

    fn create_instance(&self, model: &str) -> Result<TlaInstance, VerificationError> {
        let model = self.models.get(model).ok_or(VerificationError::ModelNotFound)?;
        Ok(TlaInstance::new(model.clone()))
    }
}

struct TlaInstance {
    model: TlaModel,
    constants: BTreeMap<String, TlaValue>,
    temp_file: NamedTempFile,
}

impl TlaInstance {
    fn new(model: TlaModel) -> Result<Self, VerificationError> {
        let mut temp_file = NamedTempFile::new()?;
        temp_file.write_all(model.content.as_bytes())?;
        Ok(Self {
            model,
            constants: BTreeMap::new(),
            temp_file,
        })
    }

    fn add_constant(&mut self, name: &str, value: TlaValue) -> Result<(), VerificationError> {
        self.constants.insert(name.into(), value);
        Ok(())
    }

    fn check(&self) -> Result<Option<String>, VerificationError> {
        let cfg_content = self.build_config();
        let cfg_file = NamedTempFile::new()?.path().to_owned();
        std::fs::write(&cfg_file, cfg_content)?;

        let output = Command::new(&self.java_path)
            .arg("-jar")
            .arg(&self.tlc_path)
            .arg("-config")
            .arg(&cfg_file)
            .arg(self.temp_file.path())
            .stdout(Stdio::piped())
            .stderr(Stdio::piped())
            .output()?;

        parse_tlc_output(&output.stdout)
    }

    fn build_config(&self) -> String {
        let mut cfg = "CONSTANTS\n".to_string();
        for (name, value) in &self.constants {
            cfg.push_str(&format!("{} = {}\n", name, value));
        }
        cfg
    }
}

