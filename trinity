impl BbrCongestionController {
    const MAX_DATAGRAM_SIZE: u64 = 1232;
    const GAIN_CYCLE_LEN: usize = 8;
    
    fn update_bbr_state(&self, delivery_rate: u64, rtt: Duration) {
        let mut state = self.state.lock();
        
        match state.phase {
            BbrPhase::Startup => {
                if delivery_rate >= state.max_bandwidth * 5/4 {
                    state.max_bandwidth = delivery_rate;
                } else {
                    state.phase = BbrPhase::Drain;
                }
            }
            BbrPhase::Drain => {
                if state.inflight >= self.btlbw * state.rt_prop {
                    state.phase = BbrPhase::ProbeBw;
                    state.cycle_idx = 0;
                }
            }
            BbrPhase::ProbeBw => {
                state.cycle_idx = (state.cycle_idx + 1) % Self::GAIN_CYCLE_LEN;
                let gain = Self::PACING_GAIN[state.cycle_idx];
                self.pacing_rate.store(
                    (state.max_bandwidth as f64 * gain) as u64,
                    Ordering::Release
                );
            }
            BbrPhase::ProbeRtt => {
                if rtt < state.rt_prop {
                    state.rt_prop = rtt;
                }
            }
        }

        // Update congestion window
        state.cwnd = (state.max_bandwidth as f64 * state.rt_prop.as_secs_f64()) as u64
            + 2 * Self::MAX_DATAGRAM_SIZE;
    }
}
struct QuicStreamManager {
    streams: HashMap<u64, QuicStreamState>,
    next_stream_id: AtomicU64,
    send_window: u64,
    recv_window: u64,
}

impl QuicStreamManager {
    const MAX_STREAMS: usize = 1000;
    
    fn open_stream(&mut self, bidirectional: bool) -> Result<u64> {
        let id = self.next_stream_id.fetch_add(2, Ordering::AcqRel);
        if self.streams.len() >= Self::MAX_STREAMS {
            return Err(TooManyStreams);
        }
        
        self.streams.insert(id, QuicStreamState {
            send_buf: VecDeque::new(),
            recv_buf: VecDeque::new(),
            send_window: self.send_window,
            recv_window: self.recv_window,
            state: if bidirectional {
                StreamState::Open
            } else {
                StreamState::SendOnly
            },
        });
        Ok(id)
    }
    
    fn handle_stream_frame(&mut self, frame: quinn::StreamFrame) -> Result<()> {
        let stream = self.streams.get_mut(&frame.stream_id)
            .ok_or(UnknownStream)?;
        
        if frame.offset > stream.recv_buf.len() as u64 {
            return Err(InvalidOffset);
        }
        
        stream.recv_buf.extend(frame.data);
        stream.recv_window -= frame.data.len() as u64;
        
        if frame.fin {
            stream.state = StreamState::Closed;
        }
        Ok(())
    }
}
struct PacketReassembler {
    fragments: HashMap<(IpAddr, u16), FragmentChain>,
    timeout: Duration,
}

impl PacketReassembler {
    const MAX_FRAGMENTS: usize = 16;
    
    fn add_fragment(&mut self, src: IpAddr, id: u16, frag: Fragment) -> Result<Option<Vec<u8>>> {
        let chain = self.fragments.entry((src, id))
            .or_insert_with(|| FragmentChain {
                fragments: BTreeMap::new(),
                expiry: Instant::now() + self.timeout,
            });
            
        if chain.fragments.len() >= Self::MAX_FRAGMENTS {
            return Err(TooManyFragments);
        }
        
        chain.fragments.insert(frag.offset, frag.data);
        
        if frag.more_fragments {
            Ok(None)
        } else {
            let total_len = chain.fragments.last_key_value()
                .map(|(k, _)| *k as usize + chain.fragments[k].len())
                .unwrap_or(0);
            
            let mut buf = Vec::with_capacity(total_len);
            for (offset, data) in &chain.fragments {
                buf.extend_from_slice(data);
            }
            self.fragments.remove(&(src, id));
            Ok(Some(buf))
        }
    }
}
struct ReputationEngine {
    scores: HashMap<PeerId, ReputationScore>,
    decay_factor: f64,
    thresholds: ReputationThresholds,
}

impl ReputationEngine {
    fn update_score(&mut self, peer: PeerId, delta: f64) {
        let entry = self.scores.entry(peer).or_default();
        entry.current = (entry.current * self.decay_factor) + delta;
        entry.lifetime += delta.abs();
        
        if entry.current < self.thresholds.ban {
            self.ban_peer(peer);
        }
    }
    
    fn ban_peer(&mut self, peer: PeerId) {
        self.scores.insert(peer, ReputationScore {
            current: f64::NEG_INFINITY,
            lifetime: 0.0,
        });
        self.network.ban_peer(peer);
    }
}
