    }

    async fn slash_validator(&self, validator: PeerId, reason: SlashReason, ratio: f64) {
        let mut state = self.state.write();
        let stake = &mut state.validator_states.get_mut(&validator).unwrap().stake;
        let slash_amount = (*stake as f64 * ratio) as u64;
        *stake -= slash_amount;
        state.validator_states.get_mut(&validator).unwrap().jailed_until = Some(Instant::now() + SLASHING_JAIL_DURATION);
        
        info!(
            "Slashing {}: {} stake burned, jailed until {:?}",
            validator,
