const INITIAL_VIEW_TIMEOUT: Duration = Duration::from_secs(4);
const MAX_VIEW_TIMEOUT: Duration = Duration::from_secs(60);
const MIN_VIEW_TIMEOUT: Duration = Duration::from_secs(2);
const SLASHING_JAIL_DURATION: Duration = Duration::from_secs(3600);

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Block {
    pub view: u64,
    pub parent_hash: [u8; 32],
    pub height: u64,
    pub timestamp: u128,
    pub transactions: Vec<Transaction>,
    pub proposer: PeerId,
    pub qc: QuorumCertificate,
    pub signature: SignatureBundle,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct QuorumCertificate {
    pub view: u64,
    pub block_hash: [u8; 32],
    pub signatures: Vec<(PeerId, Signature)>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum ConsensusMessage {
    Proposal {
        block: Block,
        last_tc: Option<TimeoutCertificate>,
    },
    Vote {
        block_hash: [u8; 32],
        view: u64,
        voter: PeerId,
        signature: Signature,
    },
    Timeout {
        view: u64,
        high_qc: QuorumCertificate,
        sender: PeerId,
        signature: Signature,
    },
    NewView {
        view: u64,
        qc: QuorumCertificate,
        sender: PeerId,
    },
}

struct ConsensusState {
    current_view: u64,
    last_view_time: Instant,
    pending_votes: HashMap<[u8; 32], Vec<Vote>>,
    timeout_certs: HashMap<u64, TimeoutCertificate>,
    block_tree: BTreeMap<u64, Block>,
    locked_view: u64,
    executed_view: u64,
    validator_states: HashMap<PeerId, ValidatorState>,
}

#[derive(Clone)]
struct ValidatorState {
    stake: u64,
    jailed_until: Option<Instant>,
    last_vote_view: u64,
}

struct ConsensusConfig {
    min_num_validators: usize,
    max_network_latency: Duration,
    stake_ratio_for_slash: f64,
}

pub struct HotStuffCore {
    state: Arc<RwLock<ConsensusState>>,
    config: ConsensusConfig,
    network_tx: UnboundedSender<ConsensusMessage>,
    keypair: Arc<identity::Keypair>,
    validator_set: Arc<ValidatorSet>,
    view_timer: Interval,
    metrics: ConsensusMetrics,
    latency_monitor: Arc<LatencyMonitor>,
}

impl HotStuffCore {
    pub fn new(
        keypair: Arc<identity::Keypair>,
        validator_set: Arc<ValidatorSet>,
        network_tx: UnboundedSender<ConsensusMessage>,
        metrics: ConsensusMetrics,
    ) -> Self {
        let state = ConsensusState {
            current_view: 0,
            last_view_time: Instant::now(),
            pending_votes: HashMap::new(),
            timeout_certs: HashMap::new(),
            block_tree: BTreeMap::new(),
            locked_view: 0,
            executed_view: 0,
            validator_states: validator_set
                .validators()
                .iter()
                .map(|(id, stake)| {
                    (
                        *id,
                        ValidatorState {
                            stake: *stake,
                            jailed_until: None,
                            last_vote_view: 0,
                        },
                    )
                })
                .collect(),
        };

        Self {
            state: Arc::new(RwLock::new(state)),
            config: ConsensusConfig {
                min_num_validators: (validator_set.total_stake() * 0.67) as usize,
                max_network_latency: Duration::from_secs(2),
                stake_ratio_for_slash: 0.01,
            },
            network_tx,
            keypair,
            validator_set,
            view_timer: tokio::time::interval(INITIAL_VIEW_TIMEOUT),
            metrics,
            latency_monitor: Arc::new(LatencyMonitor::new()),
        }
    }

    #[instrument(skip(self, block))]
    pub async fn process_proposal(&self, block: Block) -> Result<(), ConsensusError> {
        let mut state = self.state.write();
        
        // Check proposer is leader
        if !self.is_leader(block.view, &block.proposer) {
            return Err(ConsensusError::InvalidLeader);
        }

        // Verify QC
        if !self.verify_qc(&block.qc).await {
            return Err(ConsensusError::InvalidQuorumCertificate);
        }

        // Check block view is higher than locked
        if block.view <= state.locked_view {
            return Err(ConsensusError::StaleProposal);
        }

        // Update block tree
        state.block_tree.insert(block.view, block.clone());

        // Reset view timer with adaptive timeout
        let new_timeout = self.calculate_adaptive_timeout();
        self.view_timer = tokio::time::interval_at(
            Instant::now() + new_timeout,
            new_timeout,
        );
        state.last_view_time = Instant::now();

        Ok(())
    }

    fn calculate_adaptive_timeout(&self) -> Duration {
        let p95_latency = self.latency_monitor.latency_percentile(0.95);
        let timeout = p95_latency * 3.0;
        timeout.clamp(MIN_VIEW_TIMEOUT, MAX_VIEW_TIMEOUT)
    }

    #[instrument(skip(self))]
    async fn process_timeout(&self, timeout: Timeout) {
        let mut state = self.state.write();
        let view = timeout.view;

        // Check sender is not jailed
        let validator = match state.validator_states.get_mut(&timeout.sender) {
            Some(v) if v.jailed_until.map_or(true, |t| t < Instant::now()) => v,
            _ => {
                warn!("Timeout from jailed validator {}", timeout.sender);
                return;
            }
        };

        // Check timeout is for current view
        if view != state.current_view {
            return;
        }

        // Update timeout certificate
        let cert = state.timeout_certs.entry(view).or_insert_with(|| TimeoutCertificate {
            view,
            timeouts: Vec::new(),
        });
        cert.timeouts.push(timeout);

        // Check if we have 2f+1 timeouts
        if cert.timeouts.len() >= self.config.min_num_validators {
            info!("View {} timeout reached, initiating view change", view);
            self.initiate_view_change(view + 1).await;
        }
    }

    #[instrument(skip(self))]
    async fn initiate_view_change(&self, new_view: u64) {
        let state = self.state.read();
        let qc = state
            .block_tree
            .get(&state.current_view)
            .map(|b| b.qc.clone())
            .unwrap_or_else(|| QuorumCertificate::genesis());

        let msg = ConsensusMessage::NewView {
            view: new_view,
            qc,
            sender: self.keypair.public().to_peer_id(),
            signature: self
                .keypair
                .sign(&Self::new_view_signing_bytes(new_view))
                .await,
        };

        self.network_tx.unbounded_send(msg).unwrap();
        state.current_view = new_view;
    }

    #[instrument(skip(self, vote))]
    async fn process_vote(&self, vote: Vote) {
        let mut state = self.state.write();
        let validator = match state.validator_states.get_mut(&vote.voter) {
            Some(v) => v,
            None => {
                warn!("Vote from non-validator {}", vote.voter);
                return;
            }
        };

        // Check for double voting
        if validator.last_vote_view >= vote.view {
            self.slash_validator(
                vote.voter,
                SlashReason::DoubleVoting,
                self.config.stake_ratio_for_slash,
            )
            .await;
            return;
        }

        validator.last_vote_view = vote.view;

        // Aggregate votes
        let votes = state
            .pending_votes
            .entry(vote.block_hash)
            .or_insert_with(Vec::new);
        votes.push(vote);

        if votes.len() >= self.config.min_num_validators {
            let qc = self.create_qc(vote.block_hash, votes).await;
            self.commit_block(qc).await;
        }
    }

    async fn commit_block(&self, qc: QuorumCertificate) {
        let mut state = self.state.write();
        let block = match state.block_tree.get(&qc.view) {
            Some(b) => b,
            None => {
                error!("QC for unknown view {}", qc.view);
                return;
            }
        };

        // Check if we can commit a chain of three consecutive blocks
        if qc.view >= 2 {
            let ancestor_view = qc.view - 2;
            if let Some(ancestor) = state.block_tree.get(&ancestor_view) {
                state.locked_view = ancestor_view;
                if ancestor_view > state.executed_view {
                    self.execute_blocks(ancestor_view).await;
                    state.executed_view = ancestor_view;
                }
            }
        }
    }

    async fn execute_blocks(&self, up_to_view: u64) {
