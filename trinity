const SYNC_COMMITTEE_SIZE: usize = 512;
const DATA_SAMPLING_CHUNKS: usize = 64;
const FRAUD_PROOF_WINDOW: u64 = 86400; // 24h

struct LightClient {
    verification_key: Arc<groth16::VerifyingKey<Bls12>>,
    plonk_verifier: Arc<Verifier<Bls12>>,
    sync_committee: RwLock<SyncCommittee>,
    block_roots: VecDeque<H256>,
    data_roots: BTreeMap<u64, H256>,
