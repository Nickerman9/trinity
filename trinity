struct KBucket {
    nodes: VecDeque<Node>,
    last_updated: Instant,
    replacement_cache: Vec<Node>,
}

impl KBucket {
    const MAX_NODES: usize = 20;
    
    fn insert(&mut self, node: Node) -> bool {
        if let Some(pos) = self.nodes.iter().position(|n| n.id == node.id) {
            self.nodes.remove(pos);
            self.nodes.push_front(node);
            true
        } else if self.nodes.len() < Self::MAX_NODES {
            self.nodes.push_front(node);
            true
        } else {
            self.replacement_cache.push(node);
            false
        }
    }

    fn split(&mut self, depth: u8) -> (KBucket, KBucket) {
        let mut left = KBucket::new();
        let mut right = KBucket::new();
        
        for node in &self.nodes {
            if (node.id[depth as usize / 8] & (1 << (depth % 8))) == 0 {
                left.insert(node.clone());
            } else {
                right.insert(node.clone());
            }
        }
        (left, right)
    }
}

impl KademliaDHT {
    async fn handle_find_node_response(
        &mut self,
        query_id: Uuid,
        peer: PeerId,
        nodes: Vec<PeerInfo>,
    ) {
        let state = match self.pending_queries.get_mut(&query_id) {
            Some(s) => s,
            None => return,
        };

        state.waiting.remove(&peer);
        state.contacted.insert(peer);
        
        for node in nodes {
            let distance = xor_distance(&state.target, &node.key);
            state.results.push(Reverse(OrderedDistance {
                distance,
                node,
            }));
        }

        while state.results.len() > Self::BUCKET_SIZE {
            state.results.pop();
        }

        let next_peers = state.results
            .iter()
            .filter(|n| !state.contacted.contains(&n.0.node.id))
            .take(Self::PARALLELISM)
            .collect::<Vec<_>>();

        for peer in next_peers {
            self.send_find_node(query_id, peer.0.node.id, state.target).await;
            state.waiting.insert(peer.0.node.id);
        }
    }
}

