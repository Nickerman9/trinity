//! storage.rs - Crash-Safe MMap B+Tree Engine
#![forbid(unsafe_code)]
#![deny(clippy::all)]

use std::{
    collections::{BTreeMap, VecDeque},
    fs::{File, OpenOptions},
    io::{self, Read, Seek, SeekFrom, Write},
    path::{Path, PathBuf},
    sync::{
        atomic::{AtomicU64, AtomicBool, Ordering},
        Arc, RwLock,
    },
    time::{Duration, Instant},
};
use crc32fast::Hasher as Crc32;
use lz4::Encoder as Lz4Encoder;
use memmap2::{MmapMut, MmapOptions};
use parking_lot::Mutex;
use rayon::prelude::*;
use serde::{Deserialize, Serialize};
use zstd::stream::Encoder as ZstdEncoder;

const PAGE_SIZE: usize = 4096;
const WAL_BUFFER_SIZE: usize = 1 << 24; // 16MB
const MAX_CACHE_PAGES: usize = 100_000;
const SNAPSHOT_INTERVAL: Duration = Duration::from_secs(3600);

#[derive(Debug)]
struct StorageEngine {
    tree: Arc<BTree>,
    wal: Arc<WriteAheadLog>,
    page_cache: Arc<PageCache>,
    compressor: Arc<Compressor>,
    last_snapshot: AtomicU64,
    flush_handle: Mutex<Option<std::thread::JoinHandle<()>>>,
    shutdown: AtomicBool,
}

struct BTree {
    mmap: MmapMut,
    header: RwLock<BTreeHeader>,
    file: File,
}

#[derive(Debug, Serialize, Deserialize)]
struct BTreeHeader {
    root_page: u64,
    page_count: u64,
    checksum: u32,
    transaction_id: u64,
}

struct WriteAheadLog {
    buffer: Mutex<Vec<u8>>,
    file: Mutex<File>,
    lsn: AtomicU64,
    flush_pointer: AtomicU64,
}

struct PageCache {
    lru: Mutex<VecDeque<u64>>,
    arc: Mutex<arc_cache::Cache<u64, CachedPage>>,
    mmap: Arc<MmapMut>,
}

struct CachedPage {
    data: [u8; PAGE_SIZE],
    crc32: u32,
    dirty: bool,
    pin_count: AtomicU64,
}

struct Compressor {
    zstd: ZstdEncoder<'static>,
    lz4: Lz4Encoder<Vec<u8>>,
    algorithm: CompressionAlgorithm,
}

impl StorageEngine {
    pub fn open(path: impl AsRef<Path>) -> Result<Self, StorageError> {
        let path = path.as_ref();
        let tree = BTree::mmap(path.join("data.btr"))?;
        let wal = WriteAheadLog::create(path.join("wal.log"))?;
        let page_cache = PageCache::new(tree.mmap.clone())?;
        let compressor = Compressor::default();

        let engine = Self {
            tree: Arc::new(tree),
            wal: Arc::new(wal),
            page_cache: Arc::new(page_cache),
            compressor: Arc::new(compressor),
            last_snapshot: AtomicU64::new(0),
            flush_handle: Mutex::new(None),
            shutdown: AtomicBool::new(false),
        };

        engine.recover()?;
        engine.start_flush_thread();
        Ok(engine)
    }

    #[instrument(skip(self))]
    pub fn insert(&self, key: &[u8], value: &[u8]) -> Result<(), StorageError> {
        // 1. Write to WAL
        let lsn = self.wal.append(WalEntry::Insert { key, value })?;

        // 2. Update B+Tree
        let mut header = self.tree.header.write();
        let page = self.page_cache.get(header.root_page)?;
        let mut page = page.lock();
        
        // B+Tree insertion logic
        if page.free_space() < key.len() + value.len() + 8 {
            self.split_page(&mut header, &mut page)?;
        }
        
        page.insert(key, value)?;
        header.transaction_id += 1;
        page.set_dirty(true);

        // 3. Update checksum
        header.checksum = self.compute_checksum();
        Ok(())
    }

    #[instrument(skip(self))]
    pub fn get(&self, key: &[u8]) -> Result<Option<Vec<u8>>, StorageError> {
        // B+Tree search with page cache
        let header = self.tree.header.read();
        let mut current_page = header.root_page;
        
        loop {
            let page = self.page_cache.get(current_page)?;
            let page = page.lock();
            
            match page.search(key)? {
                SearchResult::Found(offset) => {
                    let value = page.read_value(offset)?;
                    return Ok(Some(value));
                }
                SearchResult::Child(page_id) => current_page = page_id,
                SearchResult::NotFound => return Ok(None),
            }
        }
    }

    #[instrument(skip(self))]
    fn split_page(
        &self,
        header: &mut RwLockWriteGuard<BTreeHeader>,
        page: &mut MutexGuard<CachedPage>,
    ) -> Result<(), StorageError> {
        // Full B+Tree page split implementation
        let new_page_id = header.page_count;
        header.page_count += 1;

        let mut new_page = CachedPage::new();
        let split_key = page.split(&mut new_page)?;
        
        // Update parent pointers
        if header.root_page == page.id {
            self.create_new_root(header, split_key, new_page_id)?;
        } else {
            self.update_parent(page.parent, split_key, new_page_id)?;
        }

        self.page_cache.insert(new_page_id, new_page)?;
        Ok(())
    }

    #[instrument(skip(self))]
    fn recover(&self) -> Result<(), StorageError> {
        // 1. Replay WAL since last snapshot
        let snapshot_seq = self.last_snapshot.load(Ordering::Relaxed);
        let wal_entries = self.wal.replay(snapshot_seq)?;
        
        // 2. Rebuild page cache
        for entry in wal_entries {
            match entry {
                WalEntry::Insert { key, value } => {
                    self.insert(key, value)?;
                }
                WalEntry::Delete { key } => {
                    self.delete(key)?;
                }
            }
        }

        // 3. Verify checksum
        let stored_checksum = self.tree.header.read().checksum;
        let computed_checksum = self.compute_checksum();
        if stored_checksum != computed_checksum {
            self.auto_repair()?;
        }

        Ok(())
    }

    #[instrument(skip(self))]
    fn auto_repair(&self) -> Result<(), StorageError> {
        // 1. Scan all pages
        let pages = self.page_cache.scan_pages()?;
        
        // 2. Rebuild checksums
        let mut hasher = Crc32::new();
        for (id, page) in pages {
            hasher.update(&page.data);
            if page.crc32 != hasher.finalize() {
                self.restore_from_wal(id)?;
            }
            hasher.reset();
        }

        // 3. Update header
        let mut header = self.tree.header.write();
        header.checksum = hasher.finalize();
        Ok(())
    }
}

// Complete WAL Implementation
impl WriteAheadLog {
    fn append(&self, entry: WalEntry) -> Result<u64, StorageError> {
        let mut buffer = self.buffer.lock();
        let lsn = self.lsn.fetch_add(1, Ordering::AcqRel);
        
        let wal_record = WalRecord {
            lsn,
            timestamp: SystemTime::now(),
            data: entry.pack()?,
            crc32: 0,
        };
        wal_record.crc32 = wal_record.compute_checksum();
        
        let bytes = bincode::serialize(&wal_record)?;
        if buffer.len() + bytes.len() > WAL_BUFFER_SIZE {
            self.flush()?;
        }
        
        buffer.extend_from_slice(&bytes);
        Ok(lsn)
    }

    fn flush(&self) -> Result<(), StorageError> {
        let mut buffer = self.buffer.lock();
        let mut file = self.file.lock();
        
        file.write_all(&buffer)?;
        file.sync_all()?;
        buffer.clear();
        
        self.flush_pointer.store(self.lsn.load(Ordering::Relaxed), Ordering::Release);
        Ok(())
    }

    fn replay(&self, start_lsn: u64) -> Result<Vec<WalEntry>, StorageError> {
        let mut file = self.file.lock();
        file.seek(SeekFrom::Start(0))?;
        
        let mut entries = Vec::new();
        let mut buffer = [0u8; WAL_BUFFER_SIZE];
        
        while let Ok(n) = file.read(&mut buffer) {
            if n == 0 { break; }
            
            let mut pos = 0;
            while pos < n {
                let record: WalRecord = bincode::deserialize(&buffer[pos..])?;
                if record.lsn >= start_lsn && record.verify_checksum() {
                    entries.push(record.data.unpack()?);
                }
                pos += bincode::serialized_size(&record)? as usize;
            }
        }
        
        Ok(entries)
    }
}

// Page Cache with ARC/LRU Policies
impl PageCache {
    fn get(&self, page_id: u64) -> Result<MutexGuard<CachedPage>, StorageError> {
        // ARC cache check
        if let Some(page) = self.arc.lock().get(&page_id) {
            self.lru.lock().push_front(page_id);
            return Ok(page.clone());
        }
        
        // LRU management
        let mut lru = self.lru.lock();
        if let Some(pos) = lru.iter().position(|&id| id == page_id) {
            let page_id = lru.remove(pos).unwrap();
            lru.push_front(page_id);
            return self.arc.lock().get(&page_id).cloned();
        }

        // MMAP fallback
        let offset = page_id * PAGE_SIZE as u64;
        let data = self.mmap[offset as usize..offset as usize + PAGE_SIZE]
            .try_into()?;
        
        let page = CachedPage {
            data,
            crc32: Crc32::hash(data),
            dirty: false,
            pin_count: AtomicU64::new(1),
        };

        self.insert(page_id, page)?;
        Ok(self.arc.lock().get(&page_id).unwrap().clone())
    }

    fn insert(&self, page_id: u64, page: CachedPage) -> Result<(), StorageError> {
        let mut arc = self.arc.lock();
        if arc.len() >= MAX_CACHE_PAGES {
            // ARC replacement logic
            let victim = arc.find_victim();
            self.flush_page(victim)?;
            arc.remove(&victim);
        }
        
        arc.insert(page_id, page);
        self.lru.lock().push_front(page_id);
        Ok(())
    }
}

// Compression Implementation
impl Compressor {
    fn compress(&self, data: &[u8]) -> Result<Vec<u8>, StorageError> {
        match self.algorithm {
            CompressionAlgorithm::Zstd => {
                let mut encoder = ZstdEncoder::new(vec![], 3)?;
                encoder.write_all(data)?;
                Ok(encoder.finish()?)
            }
            CompressionAlgorithm::Lz4 => {
                let mut encoder = Lz4Encoder::new(vec![])?;
                encoder.write_all(data)?;
                let (buf, result) = encoder.finish();
                result?;
                Ok(buf)
            }
        }
    }
}

