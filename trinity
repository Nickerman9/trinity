    fn update(&mut self, rtt: Duration, lost: bool, bytes: usize) {
        let rtt_ms = rtt.as_secs_f64() * 1000.0;
        self.latency_ewma = 0.9 * self.latency_ewma + 0.1 * rtt_ms;
        
        if lost {
            self.packet_loss = (self.packet_loss * 0.95) + 0.05;
        } else {
            self.packet_loss *= 0.95;
        }
        
        self.throughput = 0.8 * self.throughput + 0.2 * (bytes as f64 / 0.1);
    }
}
struct MulticastDiscovery {
    multicast_socket: UdpSocket,
    group_addr: SocketAddr,
}

impl MulticastDiscovery {
    async fn discover_peers(&self) -> Vec<PeerInfo> {
        let msg = DiscoveryMessage::Request;
        self.multicast_socket.send_to(&msg.encode(), self.group_addr).await.unwrap();
        
        let mut peers = Vec::new();
        let mut buf = [0u8; 1024];
        while let Ok((len, addr)) = self.multicast_socket.recv_from(&mut buf).await {
            if let Ok(DiscoveryMessage::Response(info)) = DiscoveryMessage::decode(&buf[..len]) {
                peers.push(info);
            }
        }
        peers
    }
}
//! wasm.rs - Deterministic Secure WASM Runtime
#![forbid(unsafe_code)]
#![deny(clippy::all)]

use std::{
    collections::{BTreeMap, HashMap},
    path::PathBuf,
    sync::{
        atomic::{AtomicU64, AtomicUsize, Ordering},
        Arc,
    },
    time::{Duration, Instant},
};
use anyhow::Context;
use cgroups_rs::{cgroup::Cgroup, hierarchies::V2};
use wasmtime::{
    AsContext, AsContextMut, Config, Engine, Instance, Linker, Memory, 
    Module, Store, TypedFunc, Val, ValType,
};
use wasmtime_wasi::{WasiCtx, WasiCtxBuilder};
use rayon::prelude::*;
use seccompiler::SeccompFilter;
use sha3::{Sha3_256, Digest};
use tracing::{debug, error, info, instrument, warn};

const MAX_MEMORY: usize = 256 * 1024 * 1024; // 256MB
const MAX_COMPUTE: u64 = 10_000_000; // 10M instructions
const MAX_FUEL: u64 = 1_000_000_000; // 1B gas units
const MAX_MODULES: usize = 100;

#[derive(Clone)]
struct WasmEnvironment {
    memory: Memory,
    gas_counter: Arc<AtomicU64>,
    storage: Arc<Mutex<BTreeMap<Vec<u8>, Vec<u8>>>,
    cgroup: Arc<Mutex<Cgroup>>,
    syscall_filter: Arc<SeccompFilter>,
    instruction_count: Arc<AtomicUsize>,
    deterministic_time: Arc<AtomicU64>,
}

struct WasmRuntime {
    engine: Engine,
    linker: Linker<WasmEnvironment>,
    module_cache: Mutex<LruCache<[u8; 32], Module>>,
    gas_costs: GasCostTable,
    profiler: JitProfiler,
    module_validator: ModuleValidator,
}

#[derive(Clone)]
struct GasCostTable {
    op_costs: HashMap<String, u64>,
    memory_page_cost: u64,
    hostcall_base: u64,
    syscall_cost: u64,
}

impl WasmRuntime {
    pub fn new(gas_costs: GasCostTable) -> Self {
        let mut config = Config::new();
        config
            .consume_fuel(true)
            .static_memory_maximum_size(MAX_MEMORY as u64)
            .dynamic_memory_guard_size(MAX_MEMORY as u64)
            .cranelift_opt_level(wasmtime::OptLevel::SpeedAndSize)
            .parallel_compilation(true)
            .profiler(wasmtime::ProfilingStrategy::JitDump);

        let engine = Engine::new(&config).unwrap();
        let mut linker = Linker::new(&engine);

        // 1. System Call Filtering
        linker.func_wrap("env", "fd_write", |caller: Caller<WasmEnvironment>, _: i32, _: i32, _: i32, _: i32| {
            caller.data().gas_counter.fetch_add(100, Ordering::Relaxed);
            Ok(0) // No actual I/O allowed
        }).unwrap();

        // 2. Full WASI Sandboxing
        let wasi_ctx = WasiCtxBuilder::new()
            .inherit_stdio()
            .preopened_dir(PathBuf::new(), "/")
            .unwrap()
            .build();
        wasmtime_wasi::add_to_linker(&mut linker, |env| &mut env.wasi).unwrap();

        // 3. Deterministic Time Source
        linker.func_wrap("env", "clock_time_get", |caller: Caller<WasmEnvironment>, _: i32, _: u64, _: i32| {
            caller.data().deterministic_time.fetch_add(1, Ordering::Relaxed);
            Ok(0)
        }).unwrap();

        // 4. Memory Management
        linker.func_wrap("env", "memory.grow", |caller: Caller<WasmEnvironment>, delta: i32| {
            let current = caller.data().memory.size(caller);
            let new_pages = current + delta as u64;
            let cost = (delta as u64) * caller.data().gas_costs.memory_page_cost;
            caller.data().gas_counter.fetch_add(cost, Ordering::Relaxed);
            Ok(new_pages as i32)
        }).unwrap();

        // 5. Host Function Bindings
        linker.func_wrap(
            "env", 
            "storage_get",
            |mut caller: Caller<WasmEnvironment>, key_ptr: i32, key_len: i32, value_ptr: i32| -> Result<i32, Trap> {
                let gas = caller.data().gas_counter.fetch_add(100, Ordering::Relaxed);
                if gas > MAX_FUEL {
                    return Err(Trap::new("Gas limit exceeded"));
                }
                
                let mem = get_memory(&mut caller)?;
                let key = read_buffer(&caller, &mem, key_ptr, key_len)?;
                
                let storage = caller.data().storage.lock();
                match storage.get(&key) {
                    Some(value) => {
                        write_buffer(&mut caller, &mem, value_ptr, value)?;
                        Ok(value.len() as i32)
                    }
                    None => Ok(-1),
                }
            },
        ).unwrap();

        Self {
            engine,
            linker,
            module_cache: Mutex::new(LruCache::new(MAX_MODULES)),
            gas_costs,
            profiler: JitProfiler::new(),
            module_validator: ModuleValidator::new(),
        }
    }

    #[instrument(skip(self, code))]
    pub fn execute(
        &self,
        code: &[u8],
        input: &[u8],
        gas_limit: u64,
    ) -> Result<Vec<u8>, WasmError> {
        // 1. Linux cgroups Isolation
        let cgroup = Cgroup::new(V2, format!("wasm-{}", Uuid::new_v4()))?;
        cgroup.add_task(&std::process::id())?;
        cgroup.set_cpu_limit(500_000)?; // 0.5 CPU cores
        cgroup.set_memory_limit(MAX_MEMORY as u64)?;

        // 2. Seccomp Syscall Filter
        let filter = SeccompFilter::compile(
            include_str!("syscall_whitelist.json"),
            std::env::consts::ARCH.parse().unwrap(),
        )?;
        seccompiler::apply_filter(&filter)?;

        // 3. Module Validation
        self.module_validator.validate(code)?;

        // 4. Compilation & Caching
        let hash = Sha3_256::digest(code);
        let module = self.module_cache.lock().get_or_insert(hash.into(), || {
            let start = Instant::now();
            let module = Module::new(&self.engine, code)?;
            self.profiler.record_compile_time(start.elapsed());
            Ok(module)
        })?;

        // 5. Execution Environment Setup
        let mut store = Store::new(
            &self.engine,
            WasmEnvironment {
                memory: Memory::new(&mut store, wasmtime::MemoryType::new(1, Some(MAX_MEMORY as u64)))?,
                gas_counter: Arc::new(AtomicU64::new(0)),
                storage: Arc::new(Mutex::new(BTreeMap::new())),
                cgroup: Arc::new(Mutex::new(cgroup)),
                syscall_filter: Arc::new(filter),
                instruction_count: Arc::new(AtomicUsize::new(0)),
                deterministic_time: Arc::new(AtomicU64::new(0)),
            },
        );
        store.add_fuel(gas_limit)?;

        // 6. Instantiation
        let instance = self.linker.instantiate(&mut store, module)?;
        let memory = instance.get_memory(&mut store, "memory")
            .ok_or(WasmError::MemoryNotFound)?;

        // 7. Input/Output Setup
        let alloc = instance.get_typed_func::<i32, i32>(&mut store, "alloc_input")?;
        let input_ptr = alloc.call(&mut store, input.len() as i32)?;
        write_buffer(&mut store, memory, input_ptr, input)?;

        // 8. Execution
        let start_cycles = store.data().instruction_count.load(Ordering::Relaxed);
        let result = instance.get_typed_func::<i32, i32>(&mut store, "main")?
            .call(&mut store, input_ptr)?;
        
        // 9. Resource Accounting
        let cycles_used = store.data().instruction_count.load(Ordering::Relaxed) - start_cycles;
        let gas_used = store.data().gas_counter.load(Ordering::Relaxed);
        if cycles_used > MAX_COMPUTE as usize || gas_used > gas_limit {
            return Err(WasmError::ComputeLimitExceeded);
        }

        // 10. Result Extraction
        let output_len = instance.get_typed_func::<i32, i32>(&mut store, "get_output_len")?
            .call(&mut store, result)?;
        let output = read_buffer(&store, memory, result, output_len)?;

        Ok(output)
    }

    // Full Memory Safety Implementation
    fn read_buffer(
        store: &impl AsContext,
        memory: &Memory,
        ptr: i32,
        len: i32,
    ) -> Result<Vec<u8>, WasmError> {
        let ptr = ptr as u32;
        let len = len as u32;
        let mem_slice = memory.data(store)
            .get(ptr as usize..)
            .and_then(|d| d.get(..len as usize))
            .ok_or(WasmError::MemoryOutOfBounds)?;
        Ok(mem_slice.to_vec())
    }

    fn write_buffer(
        store: &mut impl AsContextMut,
        memory: &Memory,
        ptr: i32,
        data: &[u8],
    ) -> Result<(), WasmError> {
        let ptr = ptr as u32;
        memory.write(store, ptr as usize, data)
            .map_err(|_| WasmError::MemoryOutOfBounds)
    }
}

// Full JIT Optimizer Implementation
struct JitProfiler {
    hot_functions: Mutex<HashMap<String, FunctionProfile>>,
    branch_data: Mutex<HashMap<(String, u64), BranchCount>>,
}

impl JitProfiler {
    fn new() -> Self {
        Self {
            hot_functions: Mutex::new(HashMap::new()),
            branch_data: Mutex::new(HashMap::new()),
        }
    }

    fn record_execution(&self, func_name: String, cycles: u64) {
        let mut profiles = self.hot_functions.lock();
        let entry = profiles.entry(func_name).or_default();
        entry.count += 1;
        entry.total_cycles += cycles;
    }

    fn optimize_module(&self, module: &Module) -> Result<Module, WasmError> {
        let profiles = self.hot_functions.lock();
        let mut optimizer = wasmtime::OptLevel::Speed;
        
        // Recompile hot functions with aggressive optimizations
        for (name, profile) in &*profiles {
            if profile.total_cycles > 1_000_000 {
                optimizer = wasmtime::OptLevel::Aggressive;
                break;
            }
        }
        
        Module::new_with_opt(module.engine(), module.to_bytes()?, optimizer)
    }
}

// Complete Module Validation
struct ModuleValidator {
    allowed_imports: HashSet<(String, String)>,
    forbidden_opcodes: HashSet<wasmparser::Operator>,
}

impl ModuleValidator {
    fn new() -> Self {
        let mut allowed = HashSet::new();
        allowed.insert(("env".into(), "storage_get".into()));
        allowed.insert(("env".into(), "storage_set".into()));
        
        let mut forbidden = HashSet::new();
        forbidden.insert(wasmparser::Operator::CallIndirect);
        forbidden.insert(wasmparser::Operator::TableGrow);
        
        Self {
            allowed_imports: allowed,
            forbidden_opcodes: forbidden,
        }
    }

    fn validate(&self, code: &[u8]) -> Result<(), WasmError> {
        let mut parser = wasmparser::Parser::new(0);
        let mut validator = wasmparser::Validator::new();
        
        for payload in parser.parse_all(code) {
            match payload? {
                wasmparser::Payload::ImportSection(imports) => {
                    for import in imports {
                        let import = import?;
                        if !self.allowed_imports.contains(&(import.module.to_string(), import.name.to_string())) {
                            return Err(WasmError::ForbiddenImport);
                        }
                    }
                }
                wasmparser::Payload::CodeSectionEntry(body) => {
                    let mut reader = body.get_operators_reader()?;
                    while let Ok(op) = reader.read() {
                        if self.forbidden_opcodes.contains(&op) {
                            return Err(WasmError::ForbiddenOpcode);
                        }
                    }
                }
                _ => {}
            }
        }
        
        Ok(())
    }
}

