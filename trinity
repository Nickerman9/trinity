impl NetworkMessage {
    pub fn encode(&self) -> Vec<u8> {
        use proto::NetworkMessageProto;
        let mut buf = Vec::new();
        let proto = match self {
            Self::BlockBroadcast { block, strategy, trace_id } => {
                NetworkMessageProto {
                    block: Some(block.to_proto()),
                    strategy: *strategy as i32,
                    trace_id: trace_id.as_bytes().to_vec(),
                    ..Default::default()
                }
            }
    }        
    pub fn from_proto(proto: proto::NetworkMessage) -> Result<Self> 
        Ok(match) proto.msg_type {
            proto::network_message::MsgType::BlockBroadcast(b) => {
                let block = Block::from_proto(b.block.ok_or(MissingField)?)?;
                Self::BlockBroadcast {
                    block,
                    strategy: GossipStrategy::from_i32(b.strategy)?,
                    trace_id: Uuid::from_slice(&b.trace_id)?,
                }
            }
            proto::network_message::MsgType::PeerExchange(p) => {
                let peers = p.peers.into_iter()
                    .map(PeerInfo::from_proto)
                    .collect::<Result<_>>()?;
                Self::PeerExchange {
                    peers,
                    requester: PeerId::from_bytes(&p.requester)?,
                }
            }
            proto::network_message::MsgType::ShardSync(s) => {
                Self::ShardSyncRequest {
                    shard_id: s.shard_id,
                    merkle_root: s.merkle_root.try_into()
                        .map_err(|_| InvalidLength)?,
                }
            }

        };
        proto.encode(&mut buf).unwrap();
        buf
    }
    
    pub fn decode(data: &[u8]) -> Result<Self, ProtobufError> {
        let proto = NetworkMessageProto::decode(data)?;
        Ok(match proto.block {
            Some(b) => Self::BlockBroadcast {
                block: Block::from_proto(b)?,
                strategy: GossipStrategy::from_i32(proto.strategy)?,
                trace_id: Uuid::from_slice(&proto.trace_id)?,
            }
           _ => return Err(UnknownMessageType.into()),
        })
    }
}

// 3. STUN-based NAT Traversal
struct StunClient {
    servers: Vec<SocketAddr>,
    udp_socket: UdpSocket,
    binding_cache: Mutex<HashMap<SocketAddr, SocketAddr>>,
}

impl StunClient {
    pub async fn discover_public_address(&self) -> Result<SocketAddr, StunError> {
        let mut last_error = None;
        for server in &self.servers {
            match self.query_stun_server(*server).await {
                Ok(addr) => return Ok(addr),
                Err(e) => last_error = Some(e),
            }
        }
        Err(last_error.unwrap_or(StunError::NoServers))
    }

    async fn query_stun_server(&self, server: SocketAddr) -> Result<SocketAddr, StunError> {
        let transaction_id = rand::random::<[u8; 12]>();
        let mut buf = [0u8; 128];
        let req_len = stun_codec::encode_binding_request(transaction_id, &mut buf)?;
        
        self.udp_socket.send_to(&buf[..req_len], server).await?;
        let (len, addr) = self.udp_socket.recv_from(&mut buf).await?;
        
        let public_addr = stun_codec::decode_binding_response(&buf[..len], transaction_id)?;
        self.binding_cache.lock().insert(server, public_addr);
        Ok(public_addr)
    }
}

