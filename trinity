// 7. Zero-Copy Message Forwarding
struct MessageBuffer {
    buffers: Vec<Bytes>,
    current: AtomicUsize,
}

impl MessageBuffer {
    fn forward(&self, target: &mut BytesMut) {
        let idx = self.current.load(Ordering::Acquire);
        let buf = &self.buffers[idx];
        target.extend_from_slice(buf);
        self.current.store((idx + 1) % self.buffers.len(), Ordering::Release);
    }
}

