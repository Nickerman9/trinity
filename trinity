impl EVM {
    pub fn new(storage: Arc<StorageEngine>, chain_id: U256, spec_id: SpecId) -> Self {
        let mut precompiles = [
            Precompile::ecrecover(),
            Precompile::sha256(),
            Precompile::ripemd160(),
            Precompile::identity(),
            Precompile::modexp(),
            Precompile::bn256_add(),
            Precompile::bn256_mul(),
            Precompile::bn256_pairing(),
            Precompile::blake2f(),
        ];

        if spec_id >= BERLIN {
            precompiles[4] = Precompile::modexp_berlin();
        }

        Self {
            storage,
            state: Arc::new(Mutex::new(EvmState::new())),
            chain_id,
            gas_price: U256::zero(),
            env: Env::default(),
            spec_id,
            precompiles,
            block_hashes: Vec::with_capacity(256),
        }
    }

    #[instrument(skip(self, code))]
    pub fn execute(
        &self,
        caller: H160,
        contract: H160,
        value: U256,
        code: Vec<u8>,
        gas_limit: u64,
    ) -> Result<ExecutionResult, EvmError> {
        let mut gas = Gas::new(gas_limit);
        let mut state = self.state.lock();
        let mut output = Vec::new();

        state.checkpoint();
        let exit_reason = self.execute_inner(
            &mut state,
            caller,
            contract,
            value,
            code,
            &mut gas,
            &mut output,
        );

        match exit_reason {
            ExitReason::Succeed(_) => state.commit(),
            ExitReason::Error(_) | ExitReason::Revert(_) => state.rollback(),
            ExitReason::Fatal(_) => state.discard(),
        }

        Ok(ExecutionResult {
            exit_reason,
            gas_used: gas.spend(),
            output,
            logs: state.logs.clone(),
        })
    }

    fn execute_inner(
        &self,
        state: &mut EvmState,
        caller: H160,
        contract: H160,
        value: U256,
        code: Vec<u8>,
        gas: &mut Gas,
        output: &mut Vec<u8>,
    ) -> ExitReason {
        // 1. Validate contract
        if code.len() > MAX_CODE_SIZE {
            return ExitReason::Error(Return::CodeSizeExceeded);
        }

        // 2. Load bytecode
        let code_hash = H256::from_slice(&keccak(&code));
        state.code.insert(code_hash, Bytecode::new_raw(code));

        // 3. EVM interpreter loop
        let mut pc = 0;
        let mut stack = Stack::new();
        let mut memory = Memory::new();

        loop {
            let opcode = state.code[code_hash].get(pc).unwrap_or(Opcode::STOP);

            // Gas calculation
            let gas_cost = self.gas_cost(opcode, &stack, &memory);
            if !gas.record_cost(gas_cost) {
                return ExitReason::Error(Return::OutOfGas);
            }

            // Opcode execution
            match opcode {
                Opcode::ADD => {
                    let a = stack.pop();
                    let b = stack.pop();
                    stack.push(a.overflowing_add(b).0);
                }
                Opcode::SSTORE => {
                    let key = stack.pop();
                    let value = stack.pop();
                    self.sstore(state, contract, key, value, gas)?;
                }
                Opcode::CALL => {
                    let gas_limit = stack.pop();
                    let address = H160::from(stack.pop());
                    let value = stack.pop();
                    // ... full call implementation
                }
                Opcode::CHAINID => {
                    stack.push(self.chain_id);
                }
                Opcode::BASEFEE => {
                    stack.push(self.env.block.basefee);
                }
                Opcode::DIFFICULTY => {
                    stack.push(self.env.block.difficulty);
                }
                Opcode::COINBASE => {
                    stack.push(U256::from_big_endian(
                        self.env.block.coinbase.as_bytes()
                    ));
                }
                Opcode::PREVRANDAO => {
                    stack.push(self.env.block.prevrandao.unwrap_or_default());
                }
                Opcode::BLOCKHASH => {
                    let number = stack.pop();
                    let hash = self.block_hash(number);
                    stack.push(hash);
                }
                Opcode::STATICCALL => {
                    // ... full staticcall implementation with state checks
                }
                Opcode::CREATE2 => {
                    // ... EIP-1014 implementation
                }
                Opcode::SELFDESTRUCT => {
                    // ... selfdestruct with gas refund
                }
                _ => return ExitReason::Error(Return::InvalidOpcode),
            }

            pc += 1;
        }
    }

    fn gas_cost(&self, op: Opcode, stack: &Stack, memory: &Memory) -> u64 {
        let spec = self.spec_id;
        match op {
            Opcode::SLOAD => GasCost::SLOAD.as_u64(),
            Opcode::SSTORE => {
                let current = self.storage.get(stack.peek(0));
                let new = stack.peek(1);
                GasCost::sstore_cost(spec, current, new)
            }
            Opcode::EXP => {
                let exponent = stack.peek(1);
                GasCost::exp_cost(exponent)
            }
            Opcode::CALL => GasCost::call_cost(
                spec,
                stack.peek(2),
                stack.peek(3),
                stack.peek(4),
            ),
            Opcode::SHA3 => GasCost::sha3_cost(memory.read(
                stack.peek(0).as_usize(),
                stack.peek(1).as_usize(),
            )),
            // ... full gas cost matrix for all opcodes
        }
    }

    fn sstore(
        &self,
        state: &mut EvmState,
        contract: H160,
        key: U256,
        value: U256,
        gas: &mut Gas,
    ) -> Result<(), EvmError> {
        let current = state.storage.get(contract, key);
        let original = state.storage.get_original(contract, key);
        let gas_cost = GasCost::sstore_cost(self.spec_id, current, value);

        gas.record_cost(gas_cost)?;
        state.storage.set(contract, key, value);

        // EIP-2200 refund logic
        let refund = match (original, current, value) {
            (_, _, 0) if current != 0 => GasCost::SSTORE_CLEAR_REFUND,
            (x, y, z) if x == y && y != z => GasCost::SSTORE_RESET_REFUND,
            _ => 0,
        };

        gas.record_refund(refund);
        Ok(())
    }

    fn block_hash(&self, number: U256) -> U256 {
        let current = self.env.block.number;
        if number >= current || number + 256 < current {
            U256::zero()
        } else {
            let index = (current - number - 1).as_usize();
            U256::from_big_endian(
                self.block_hashes.get(index).unwrap_or(&H256::zero()).as_bytes()
            )
        }
    }
}

