#[derive(Debug, Error)]
pub enum ConsensusError {
    #[error("Invalid quorum certificate")]
    InvalidQuorumCertificate,
    #[error("Proposer is not leader for current view")]
    InvalidLeader,
    #[error("Block view is not higher than locked view")]
    StaleProposal,
    #[error("Invalid block signature")]
    InvalidBlockSignature,
    #[error("Conflicting block at same view")]
    BlockConflict,
    #[error("Invalid transaction ordering")]
    TransactionOrderViolation,
    #[error("State transition verification failed")]
    StateTransitionError,
    #[error("Invalid timeout certificate aggregation")]
    InvalidTimeoutCertificate,
    #[error("View synchronization timeout")]
    ViewSyncTimeout,
    #[error("Double voting detected")]
    DoubleVoting,
    #[error("Stale vote for previous view")]
    StaleVote,
    #[error("Insufficient validator stake")]
    InsufficientStake,
    #[error("Validator jailed")]
    ValidatorJailed,
    #[error("Invalid parent block reference")]
    ParentHashMismatch,
    #[error("Block timestamp in future")]
    FutureTimestamp,
    #[error("Certificate threshold not reached")]
    InsufficientSignatures,
    #[error("View number mismatch in new-view message")]
    ViewNumberMismatch,
}
//! network.rs - QUIC Hybrid Transport with Adaptive Gossip
#![forbid(unsafe_code)]
#![deny(clippy::all)]

use std::{
    collections::{HashMap, HashSet, VecDeque},
    net::{IpAddr, SocketAddr},
    sync::{
        atomic::{AtomicU64, AtomicUsize, Ordering},
        Arc,
    },
    time::{Duration, Instant},
};
use async_trait::async_trait;
use bytes::Bytes;
use parking_lot::{Mutex, RwLock};
use quinn::{
    ClientConfig, Endpoint, IdleTimeout, ServerConfig, TransportConfig,
    VarInt,
};
use serde::{Deserialize, Serialize};
use tracing::{debug, error, info, instrument, warn};
use uuid::Uuid;

const MAX_PEERS: usize = 250;
const PEER_SCORE_DECAY: f64 = 0.95;
const GOSSIP_FANOUT: usize = 6;
const BANDWIDTH_LIMIT: u64 = 10 * 1024 * 1024; // 10 MB/s
const CONNECTION_TIMEOUT: Duration = Duration::from_secs(10);

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum NetworkMessage {
    BlockBroadcast {
        block: Block,
        strategy: GossipStrategy,
        trace_id: Uuid,
    },
    ConsensusMessage {
        msg: ConsensusMessage,
        urgent: bool,
    },
    PeerExchange {
        peers: Vec<PeerInfo>,
        requester: PeerId,
    },
    ShardSyncRequest {
        shard_id: u64,
        merkle_root: [u8; 32],
    },
}

#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
pub enum GossipStrategy {
    PlumTree,
    Epidemic,
    Direct,
}

struct PeerScore {
    latency: ExponentialWeightedAverage,
    validity: f64,
    stability: f64,
    last_seen: Instant,
}

struct AdaptiveGossip {
    plumtree: PlumTreeState,
    epidemic: EpidemicState,
    scores: Arc<RwLock<HashMap<PeerId, PeerScore>>>,
    bandwidth_usage: Arc<AtomicU64>,
}

struct PlumTreeState {
    eager_push: HashMap<MessageId, HashSet<PeerId>>,
    lazy_push: HashMap<MessageId, HashSet<PeerId>>,
    message_cache: LruCache<MessageId, NetworkMessage>,
}

struct EpidemicState {
    infected: HashSet<MessageId>,
    anti_entropy: Interval,
}

struct SecureTransport {
    quic_endpoint: Endpoint,
    allowlist: RwLock<HashSet<PeerId>>,
    connection_pool: Mutex<HashMap<PeerId, quinn::Connection>>,
    peer_discovery: PeerDiscoveryService,
    challenge_responder: Arc<dyn ChallengeResponder>,
}

pub struct NetworkCore {
    transport: Arc<SecureTransport>,
    gossip: Arc<AdaptiveGossip>,
    message_queue: VecDeque<(NetworkMessage, GossipStrategy)>,
    rate_limiter: TokenBucket,
    metrics: NetworkMetrics,
    shutdown: AtomicBool,
}

impl SecureTransport {
    pub fn new(
        keypair: &identity::Keypair,
        listen_addr: SocketAddr,
    ) -> Result<Self, NetworkError> {
        let crypto = Self::build_crypto(keypair)?;
        let mut server_config = ServerConfig::with_crypto(crypto.clone());
        let mut transport = TransportConfig::default();
        transport.keep_alive_interval(Some(Duration::from_secs(5)));
        transport.max_idle_timeout(Some(IdleTimeout::from(VarInt::from_u32(10_000))));
        server_config.transport = Arc::new(transport);

        let mut endpoint = Endpoint::server(server_config, listen_addr)?;
        let client_config = ClientConfig::new(crypto);
        endpoint.set_default_client_config(client_config);

        Ok(Self {
            quic_endpoint: endpoint,
            allowlist: RwLock::new(HashSet::new()),
            connection_pool: Mutex::new(HashMap::new()),
            peer_discovery: PeerDiscoveryService::new(),
            challenge_responder: Arc::new(ProofOfWork::new(20)),
        })
    }

    #[instrument(skip(self))]
    pub async fn dial(
        &self,
        peer_id: PeerId,
        addr: SocketAddr,
    ) -> Result<quinn::Connection, NetworkError> {
        let challenge = self.challenge_responder.generate_challenge(peer_id);
        let conn = self.quic_endpoint.connect(addr, "blockchain")?.await?;
        
        // Perform mutual authentication
        let proof = conn.open_bi().await?.1.read_exact(challenge.len()).await?;
        if !self.challenge_responder.verify_challenge(peer_id, &challenge, &proof) {
            return Err(NetworkError::AuthenticationFailed);
        }

        // Send our proof
        let our_proof = self.challenge_responder.generate_proof(peer_id);
        conn.open_bi().await?.0.write_all(&our_proof).await?;

        self.connection_pool.lock().insert(peer_id, conn.clone());
        Ok(conn)
    }

    #[instrument(skip(self))]
    pub async fn accept_connections(&self) {
        while let Some(conn) = self.quic_endpoint.accept().await {
            let conn = match conn.await {
                Ok(c) => c,
                Err(e) => {
                    warn!("Connection failed: {}", e);
                    continue;
                }
            };

            let peer_id = self.authenticate_connection(&conn).await;
            self.allowlist.write().insert(peer_id);
            self.connection_pool.lock().insert(peer_id, conn);
        }
    }

    async fn authenticate_connection(
        &self,
        conn: &quinn::Connection,
    ) -> PeerId {
        // Full mutual authentication flow
        let (mut send, mut recv) = conn.accept_bi().await.unwrap();
        let challenge = self.challenge_responder.generate_challenge(PeerId::random());
        send.write_all(&challenge).await.unwrap();
        
        let proof = recv.read_exact(challenge.len()).await.unwrap();
        let peer_id = self.challenge_responder.decode_peer_id(&proof);
        
        let our_proof = self.challenge_responder.generate_proof(peer_id);
        send.write_all(&our_proof).await.unwrap();
        
        peer_id
    }
}

impl AdaptiveGossip {
    pub fn new() -> Self {
        Self {
            plumtree: PlumTreeState {
                eager_push: HashMap::new(),
                lazy_push: HashMap::new(),
                message_cache: LruCache::new(10_000),
            },
            epidemic: EpidemicState {
                infected: HashSet::new(),
                anti_entropy: tokio::time::interval(Duration::from_secs(30)),
            },
            scores: Arc::new(RwLock::new(HashMap::new())),
            bandwidth_usage: Arc::new(AtomicU64::new(0)),
        }
    }

    #[instrument(skip(self, message))]
    pub async fn broadcast(
        &mut self,
        message: NetworkMessage,
        strategy: GossipStrategy,
    ) {
        let message_id = Self::message_id(&message);
        match strategy {
            GossipStrategy::PlumTree => self.plumtree_broadcast(message_id, message).await,
            GossipStrategy::Epidemic => self.epidemic_broadcast(message_id, message).await,
            GossipStrategy::Direct => self.direct_send(message).await,
        }
    }

    async fn plumtree_broadcast(&mut self, id: MessageId, msg: NetworkMessage) {
        self.plumtree.message_cache.insert(id, msg.clone());
        let peers = self.select_eager_peers(id);
        for peer in peers {
            self.send_message(peer, msg.clone(), GossipStrategy::PlumTree).await;
            self.plumtree.eager_push.entry(id).or_default().insert(peer);
        }
    }

    async fn epidemic_broadcast(&mut self, id: MessageId, msg: NetworkMessage) {
        if self.epidemic.infected.insert(id) {
            let peers = self.select_gossip_peers();
            for peer in peers {
                self.send_message(peer, msg.clone(), GossipStrategy::Epidemic).await;
            }
        }
    }

    async fn direct_send(&mut self, msg: NetworkMessage) {
        if let Some(peer) = self.select_direct_peer() {
            self.send_message(peer, msg, GossipStrategy::Direct).await;
        }
    }

    fn select_eager_peers(&self, id: MessageId) -> Vec<PeerId> {
        let scores = self.scores.read();
        let mut peers: Vec<_> = scores.keys().copied().collect();
        peers.sort_by(|a, b| {
            scores[b].score().partial_cmp(&scores[a].score()).unwrap()
        });
        peers.into_iter().take(GOSSIP_FANOUT).collect()
    }

    #[instrument(skip(self))]
    pub async fn handle_message(
        &mut self,
        sender: PeerId,
        msg: NetworkMessage,
        strategy: GossipStrategy,
    ) {
        let id = Self::message_id(&msg);
        match strategy {
            GossipStrategy::PlumTree => {
                if self.plumtree.message_cache.get(&id).is_none() {
                    self.plumtree.message_cache.insert(id, msg.clone());
                    let peers = self.select_lazy_peers(id, sender);
                    for peer in peers {
                        self.send_message(peer, msg.clone(), strategy).await;
                    }
                }
                self.plumtree.eager_push.entry(id).or_default().remove(&sender);
            }
            GossipStrategy::Epidemic => {
                if self.epidemic.infected.insert(id) {
                    let peers = self.select_gossip_peers();
                    for peer in peers {
                        if peer != sender {
                            self.send_message(peer, msg.clone(), strategy).await;
                        }
                    }
                }
            }
            GossipStrategy::Direct => {} // No propagation
        }
    }
}

impl NetworkCore {
    pub async fn run(&self) {
        let listener = self.transport.accept_connections();
        let gossiper = self.run_gossip_loop();
        let bandwidth_monitor = self.enforce_bandwidth_limits();
        
        tokio::select! {
            _ = listener => {},
            _ = gossiper => {},
            _ = bandwidth_monitor => {},
            _ = self.shutdown.wait() => {
                info!("Shutting down network layer");
            }
        }
    }

    async fn run_gossip_loop(&self) {
        let mut interval = tokio::time::interval(Duration::from_secs(1));
        loop {
            interval.tick().await;
            let messages = self.message_queue.lock().drain(..).collect::<Vec<_>>();
            
            for (msg, strategy) in messages {
                if self.rate_limiter.check_limit(msg.size()) {
                    self.gossip.broadcast(msg, strategy).await;
                } else {
                    warn!("Rate limiting message of size {}", msg.size());
                }
            }
        }
    }

    async fn enforce_bandwidth_limits(&self) {
        let mut interval = tokio::time::interval(Duration::from_secs(1));
        loop {
            interval.tick().await;
            let usage = self.bandwidth_usage.swap(0, Ordering::Relaxed);
            if usage > BANDWIDTH_LIMIT {
                warn!("Bandwidth limit exceeded: {}/{}", usage, BANDWIDTH_LIMIT);
                self.throttle_peers().await;
            }
        }
    }

    async fn throttle_peers(&self) {
        let peers = self.transport.connection_pool.lock().keys().copied().collect::<Vec<_>>();
        for peer in peers {
            if let Some(conn) = self.transport.connection_pool.lock().get(&peer) {
                if let Err(e) = conn.set_priority(quinn::Priority::DEFAULT.sub(1)) {
                    warn!("Failed to throttle {}: {}", peer, e);
                }
            }
        }
    }
}

