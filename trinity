const SHARD_COMMIT_TIMEOUT: Duration = Duration::from_secs(10);
const MAX_CROSS_SHARD_STEPS: u8 = 8;
const MERKLE_PROOF_DEPTH: usize = 32;
const SHARD_REBALANCE_THRESHOLD: f64 = 0.3;

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum ShardMessage {
    Prepare {
        tx_id: [u8; 32],
        operations: BTreeMap<ShardId, Vec<ShardOp>>,
        initiator: ShardId,
    },
    Prepared {
        tx_id: [u8; 32],
        shard_id: ShardId,
        proof: MerkleProof,
        signature: Signature,
    },
    Commit {
        tx_id: [u8; 32],
