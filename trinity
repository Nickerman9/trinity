impl MonitoringSystem {
    pub fn new() -> Self {
        let registry = Arc::new(Registry::new());
        let metrics = Metrics::new(registry.clone());
        let anomaly_detector = Arc::new(AnomalyDetector::new());
        let alert_manager = Arc::new(AlertManager::new());
        let health_checks = Arc::new(HealthCheckRegistry::new());
        let tracing = Arc::new(TracingSystem::new());
        let audit_log = Arc::new(AuditLog::new(Duration::from_secs(86400 * 7))); // 7 days
        let postmortem = Arc::new(PostmortemSystem::new());

        Self {
            registry,
            metrics,
            anomaly_detector,
            alert_manager,
            health_checks,
            tracing,
            audit_log,
            postmortem,
        }
    }

    #[instrument(skip(self))]
    pub fn start(&self) {
        self.start_metrics_collection();
        self.start_anomaly_detection();
        self.start_health_checks();
        self.start_audit_log_cleanup();
    }

    #[instrument(skip(self))]
    fn start_metrics_collection(&self) {
        let metrics = self.metrics.clone();
        tokio::spawn(async move {
            let mut interval = tokio::time::interval(METRICS_INTERVAL);
            loop {
                interval.tick().await;
                metrics.collect();
            }
        });
    }

    #[instrument(skip(self))]
    fn start_anomaly_detection(&self) {
        let detector = self.anomaly_detector.clone();
        tokio::spawn(async move {
            let mut interval = tokio::time::interval(Duration::from_secs(1));
            loop {
                interval.tick().await;
                detector.detect_anomalies().await;
            }
        });
    }

    #[instrument(skip(self))]
    fn start_health_checks(&self) {
        let health_checks = self.health_checks.clone();
        tokio::spawn(async move {
            let mut interval = tokio::time::interval(HEALTH_CHECK_TIMEOUT);
            loop {
                interval.tick().await;
                health_checks.run_checks().await;
            }
        });
    }

    #[instrument(skip(self))]
    fn start_audit_log_cleanup(&self) {
        let audit_log = self.audit_log.clone();
        tokio::spawn(async move {
            let mut interval = tokio::time::interval(Duration::from_secs(3600));
            loop {
                interval.tick().await;
                audit_log.cleanup().await;
            }
        });
    }

    #[instrument(skip(self))]
    pub fn record_incident(&self, incident: Incident) {
        self.postmortem.record(incident);
        self.alert_manager.trigger_alert(&incident);
    }
}

